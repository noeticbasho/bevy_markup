sheet-title = Charakterbogen
sheet-drag = Ziehen dreht die Heldin, Klicken wechselt die Rüstung.
sheet-name = Name: <b>{ $name }</b>
sheet-armor = Rüstung: <b>{ $armor ->
        [leather] Leder
        [steel] Stahl
       *[gold] Gold
    }</b>
sheet-thumb = Dieselbe Kamera, als Bild gezeigt.
sheet-armor-button = Rüstung wechseln
sheet-toggle = { $shown ->
        [true] Porträt ausblenden
       *[other] Porträt einblenden
    }
sheet-language = Sprache: Deutsch
sheet-status = { $rendering ->
        [true] Die Porträtkamera rendert.
       *[other] Die Porträtkamera ist aus: keine Leinwand zeigt sie.
    }
sheet-hint = Porträt ziehen oder anklicken. Q / E oder LB / RB drehen die Heldin. ↑ ↓ / Steuerkreuz und Enter / A drücken die Knöpfe. Leertaste / Y wechselt die Sprache.
